# Dependencies — reinstalled from package-lock.json, never committed.
node_modules/

# Build output — regenerated by `npm run build` in each workspace.
dist/
*.tsbuildinfo

# Environment files — real secrets live here locally or on the hosting
# platform's dashboard, never in git. Only the checked-in `.env.example`
# templates should ever be tracked.
.env
.env.*
!.env.example
!*/.env.example

# Local file storage (STORAGE_DRIVER=local) — user-uploaded receipts have no
# business in source control under any circumstance.
server/storage/

# Test/coverage output.
coverage/
.nyc_output/

# Logs.
*.log
npm-debug.log*

# OS/editor cruft.
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Claude Code's local session/tool config — machine-specific, not app source.
.claude/
