# ───────────────────────────────────────────────────────────────
# Khata — server environment
# Copy to `.env` and adjust. Every variable below is documented in
# docs/DEPLOYMENT.md. Values shown are the defaults.
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Public URLs -----------------------------------------------------
# API_URL is used to build absolute links (attachment downloads, email links).
API_URL=http://localhost:4000
# APP_URL is the browser app. It is always an allowed CORS origin and is the
# base for links inside verification / password-reset emails.
APP_URL=http://localhost:5173
# Additional allowed origins, comma separated. Optional.
# CORS_ORIGINS=https://khata.example.com,https://www.khata.example.com

# Database --------------------------------------------------------
# REQUIRED IN PRODUCTION. Leave blank in development and the server boots a
# throwaway in-process MongoDB so a fresh clone runs with no external services.
# Multi-document transactions need a replica set — MongoDB Atlas gives you one
# by default; a standalone mongod does not, and the server falls back to
# sequential writes with a warning.
# MONGODB_URI=mongodb://127.0.0.1:27017/khata
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/khata?retryWrites=true&w=majority
MONGODB_DB_NAME=khata

# Auth ------------------------------------------------------------
# REQUIRED IN PRODUCTION, minimum 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development, ephemeral secrets are generated at boot (restarting the server
# invalidates existing sessions).
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Refresh-token cookie. `auto` = secure when NODE_ENV=production.
COOKIE_SECURE=auto
# Set when the API and the app sit on different subdomains of one site.
# COOKIE_DOMAIN=.khata.example.com
# Set to true ONLY when the frontend and API are on different domains entirely
# (e.g. a Vercel frontend calling a Render API) — this is the split-hosting case.
# Leave false when they share a domain (including subdomains of the same site).
# Getting this wrong in the cross-site direction (leaving it false) does not fail
# loudly — it just means users get silently signed out shortly after logging in,
# because the browser withholds a same-site cookie from a cross-site request.
COOKIE_CROSS_SITE=false

# Email -----------------------------------------------------------
# Without SMTP_HOST, emails are written to the server log instead of being sent,
# which is what you want in development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Khata <no-reply@khata.app>

# File storage ----------------------------------------------------
# `local` writes under STORAGE_DIR — fine for development, but most hosting
# platforms (including Render's standard web service) wipe local disk on every
# deploy/restart, so receipts would not survive. Use `s3` in production.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# Required when STORAGE_DRIVER=s3. Works with real AWS S3 or an S3-compatible
# service (Cloudflare R2, DigitalOcean Spaces, MinIO) via S3_ENDPOINT.
# The bucket must have "Block all public access" enabled — this app only ever
# reads files back through its own authenticated API, never a direct object URL.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Rate limiting ---------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# Operations ------------------------------------------------------
LOG_LEVEL=info
# Run recurring-transaction posting and reminder generation in this process.
# Set to false if you run them as a separate worker/cron.
ENABLE_SCHEDULER=true
# Development-only helper endpoints (demo data reset, mail preview). Never true in production.
ENABLE_DEV_ROUTES=false
